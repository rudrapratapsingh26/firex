{
  "name": "firex",
  "private": true,
  "type": "module",
  "description": "FireX monorepo: node firmware, site gateway, ledger and verifier, simulator.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dashboard",
    "build": "tsc",
    "vectors": "node --experimental-strip-types ledger/src/vectors.ts",
    "golden:c": "node --experimental-strip-types ledger/src/golden-c.ts",
    "verify": "node --experimental-strip-types ledger/src/cli.ts verify",
    "demo": "node --experimental-strip-types ledger/src/cli.ts demo",
    "demo:escalation": "node --experimental-strip-types gateway/escalation/demo.ts",
    "mock:endpoints": "node --experimental-strip-types gateway/escalation/mock-endpoints.ts",
    "escalation:dry-run": "node --experimental-strip-types gateway/escalation/dry-run.ts",
    "fusion:test": "make -C firmware test",
    "fusion:lib": "make -C firmware lib",
    "sim": "python tools/simulator/simulate.py",
    "tools:test": "python -m unittest discover -s tools -p \"test_*.py\"",
    "gateway": "node --experimental-strip-types gateway/server/main.ts",
    "gateway:cli": "node --experimental-strip-types gateway/server/cli.ts",
    "sim:node": "node --experimental-strip-types gateway/sim/node-sim.ts",
    "dev:broker": "node --experimental-strip-types gateway/sim/dev-broker.ts",
    "golden:provision": "node --experimental-strip-types gateway/sim/golden-provision.ts",
    "dashboard:dev": "vite --config dashboard/vite.config.ts",
    "dashboard:build": "vite build --config dashboard/vite.config.ts"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "aedes": "^1.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@peculiar/x509": "^2.1.0",
    "fastify": "^5.12.4",
    "mqtt": "^5.15.2",
    "reflect-metadata": "^0.2.2"
  }
}
