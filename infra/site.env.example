# Copy to site.env and edit. Used by: docker compose --env-file site.env up -d
FIREX_SITE_ID=site-001
FIREX_SITE_NAME=Hostel, Block B
# The name desk PCs use for the dashboard, and the fixed LAN address units use
# for MQTT and provisioning (reserve it on the router).
FIREX_HOSTNAME=firex-gateway.local
FIREX_GATEWAY_IP=192.168.1.10
FIREX_MEDIA_RETENTION_DAYS=30
# Escalation (docs/service-registry.md). off, console, http or modem. A pilot site uses modem:
# a USB GSM modem on the gateway (uncomment its device in docker-compose.yml). http is for
# mock endpoints in a dry run. The registry decides who receives real incidents: every
# service is a drill contact until the registry marks it live and names its agreement.
# The registry path is inside the firex-data volume; its ack_timeout_s and max_realerts,
# when present, take precedence over the two settings below.
FIREX_ALERT_PROVIDER=off
FIREX_SERVICE_REGISTRY=/data/service-registry.json
FIREX_ALERT_HTTP_URL=
FIREX_ALERT_ACK_TIMEOUT_S=60
FIREX_ALERT_MAX_REALERTS=1
FIREX_MODEM_DEVICE=/dev/ttyUSB2
FIREX_MODEM_BAUD=115200
FIREX_MODEM_RING_S=30
# Firmware rollouts: the SHA-256 digest of the release signing key the units trust
# (espsecure.py digest_sbv2_public_key). Without it the gateway checks signatures but not whose.
FIREX_FW_SIGNING_KEY_SHA256=
# Set to ntp once `timedatectl` on the Pi says the clock is synchronised.
FIREX_CLOCK_SOURCE=uncertain
